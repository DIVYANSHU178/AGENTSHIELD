# =============================================================================
# AgentShield Frontend Environment Configuration Template (.env.example)
# Phase 15 Secrets & Configuration Hardening
#
# IMPORTANT SECURITY RULES:
# 1. Frontend environments are PUBLISHED to browser clients.
# 2. NEVER put server secrets, passwords, or private signing keys in VITE_* variables.
# 3. Only non-sensitive public endpoints and environment labels belong here.
# =============================================================================

# API Gateway Endpoint
# Leave empty to automatically derive from browser window.location (default).
# Override only if accessing a remote or custom API gateway host.
# VITE_API_BASE_URL=http://localhost:8000

# Environment Label Override (defaults to 'development' in dev mode)
# VITE_ENVIRONMENT=development
