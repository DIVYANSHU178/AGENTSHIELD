# =============================================================================
# AgentShield Backend Environment Configuration Template (.env.example)
# Phase 15 Secrets & Configuration Hardening
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit production secrets or credentials to version control.
# 2. In production, AGENTSHIELD_AUTHORIZATION_SECRET and SECRET_KEY are MANDATORY
#    and must be >= 32 characters long.
# 3. In production, ALLOW_DEFAULT_CREDENTIALS must remain False (or unset).
# =============================================================================

# Application Identity & Mode
APP_NAME=AgentShield
ENVIRONMENT=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000

# Persistence & Storage
# For development / QA SQLite:
DATABASE_URL=sqlite:///./agentshield.db
QA_DATABASE_URL=sqlite:///./agentshield_qa.db
# For production PostgreSQL (use secrets manager or secure environment injection):
# DATABASE_URL=postgresql://agentshield_app:CHANGE_ME_PASSWORD@db.internal:5432/agentshield_prod

# Cryptographic Material & Signing Keys
# MANDATORY in production: minimum 32 characters high-entropy string
# AGENTSHIELD_AUTHORIZATION_SECRET=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_32_CHAR_SECRET
# SECRET_KEY=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_32_CHAR_SECRET

# Security & Access Control
# Set to false in production. When true in dev/qa, default accounts (admin, reviewer) are seeded on empty DB.
ALLOW_DEFAULT_CREDENTIALS=false

# CORS (Cross-Origin Resource Sharing)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Optional custom origin regex (disabled in production unless explicitly set)
# CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Model Providers (Local Ollama / Model Gateway)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3
